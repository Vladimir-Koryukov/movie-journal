# 1. Последние JSON-события за 60 минут
_time:60m structured:true | sort by (_time) desc | limit 100

# 2. Предупреждения frontend
_time:60m structured:true service.name:movie-journal-frontend level:warn | sort by (_time) desc | limit 100 | fields _time, service.name, level, status, method, path, _msg

# 3. Число событий по сервисам и уровням
_time:60m structured:true | stats by (service.name, level) count() as logs

# 4. Пять самых частых HTTP-методов frontend
_time:60m structured:true service.name:movie-journal-frontend | top 5 by (method)

# 5. События аутентификации и регистрации
_time:60m structured:true event_name:~"user_.*" | sort by (_time) desc | fields _time, event_name, outcome, reason, user_id

# 6. Операции с личной коллекцией
_time:60m structured:true event_name:~"diary_entr.*" | sort by (_time) desc | fields _time, event_name, outcome, source, scope, result_count, user_id, entry_id, catalog_provider, catalog_id

# 7. Обращения к каталогу OMDb
_time:60m structured:true event_name:movie_catalog_request | sort by (_time) desc | fields _time, provider, operation, outcome, duration_ms, result_count, catalog_id
